{
  "output_dir": "outputs",
  "ffmpeg_bin": "ffmpeg",
  "ffprobe_bin": "ffprobe",
  "rvc": {
    "mode": "command",
    "base_url": "http://127.0.0.1:7898",
    "timeout_seconds": 240,
    "runtime_python": "<RVC_ROOT>/runtime/python.exe",
    "rvc_root": "<RVC_ROOT>",
    "model": "<MODEL>.pth",
    "index": "",
    "pitch": 0,
    "tts_command": [
      "{runtime_python}",
      "{sapi_tts}",
      "--voice",
      "Microsoft Huihui",
      "--text",
      "{text}",
      "--rate",
      "{rate}",
      "--output",
      "{output}"
    ],
    "convert_command": [
      "{runtime_python}",
      "{rvc_bridge}",
      "--rvc-root",
      "{rvc_root}",
      "--input",
      "{input}",
      "--output",
      "{output}",
      "--model",
      "{model}",
      "--index",
      "{index}",
      "--pitch",
      "{pitch}"
    ]
  },
  "jimeng": {
    "executable": "dreamina",
    "model": "seedance2.0fast_vip",
    "ratio": "16:9",
    "duration": 10,
    "video_resolution": "720p",
    "images": [],
    "audio_references": []
  },
  "recording": {
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "fps": 24
  },
  "render": {
    "shot_seconds": 6,
    "crf": 19,
    "preset": "fast"
  }
}
